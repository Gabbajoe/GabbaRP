ignore:
  - CLAUDE.md
  - AGENTS.md
  - docs
  - tools

# Without this, the packager auto-generates its own CHANGELOG.md from raw git commit
# messages (including things like "Co-Authored-By" lines) and uses that same text as the
# CurseForge/GitHub release description -- using our own curated, player-facing changelog
# instead for both. Points at CHANGELOG-release.md (generated by the release workflow, just
# before this step, by extracting the newest section from the real CHANGELOG.md), not
# CHANGELOG.md itself -- the packager uses whatever manual-changelog points to VERBATIM,
# full file and all, with no "just the newest section" extraction of its own, so pointing
# this at the full cumulative CHANGELOG.md would repost the entire changelog history as
# every single release's description.
manual-changelog:
  filename: CHANGELOG-release.md
  markup-type: markdown
